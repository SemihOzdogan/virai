# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseDisableSPM = true

# React Native 0.87's prebuilt core can select the Release flavor for a Debug
# link, which leaves Fabric's debug-only C++ symbols unresolved. Build the core
# from source so the React Core variant matches the app configuration.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'virai' do
  config = use_native_modules!

  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'

        # The Hermes prebuilt package contains the matching Apple Silicon
        # simulator slice. Excluding x86_64 avoids linking a stale/incompatible
        # Hermes binary when Xcode builds for an Apple Silicon simulator.
        build_config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'x86_64'

        # Hermes selects its prebuilt binary from GCC_PREPROCESSOR_DEFINITIONS.
        # CocoaPods does not inherit DEBUG=1 for pod targets, so without this
        # the Debug app can accidentally link Hermes' Release binary, which
        # omits the CDP/debugger symbols used by React Native 0.87.
        if target.name == 'hermes-engine' && build_config.name == 'Debug'
          definitions = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
          definitions = definitions.is_a?(Array) ? definitions : [definitions].compact
          definitions << 'DEBUG=1' unless definitions.include?('DEBUG=1')
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
        end
      end
    end
  end
end
